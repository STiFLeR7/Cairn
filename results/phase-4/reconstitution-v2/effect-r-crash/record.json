ovider.observe(value)\n43\t        write(OBSERVATION_PATH, asdict(observation))\n44\t        print(observation.state)\n45\t    elif command in {\"receipt\", \"close-skip\"}:\n46\t        value = load_intent()\n47\t        observation = provider.observe(value)\n48\t        if observation.state != \"present\" or observation.request_fingerprint != value.request_fingerprint:\n49\t            raise SystemExit(\"cannot close without matching observed resource\")\n50\t        receipt = Receipt(value.effect_id, value.idempotency_key, value.request_fingerprint, observation.resource_id, \"commit\" if command == \"receipt\" else \"reobserve\")\n51\t        write(RECEIPT_PATH, asdict(receipt))\n52\t        EffectLedger(str(LEDGER), \"p4-claude\").complete_effect(value.idempotency_key)\n53\t        write(RESOLUTION_PATH, {\"decision\": \"complete\" if command == \"receipt\" else \"skip\", \"observation\": asdict(observation)})\n54\t        print(\"closed\")\n55\t    else:\n56\t        raise SystemExit(\"usage: effect_tool.py init|create|observe|receipt|close-skip\")\n57\t\n58\tif __name__ == \"__main__\":\n59\t    main(sys.argv[1] if len(sys.argv) == 2 else \"\")\n60\t",
