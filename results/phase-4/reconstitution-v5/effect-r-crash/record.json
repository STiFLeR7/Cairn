            "content": "1\timport json\n2\timport sys\n3\tfrom dataclasses import asdict\n4\tfrom pathlib import Path\n5\t\n6\tsys.path[:0] = ['D:\\\\project-unknown-phase4', 'D:\\\\project-unknown-phase4\\\\src']\n7\tfrom benchmarks.p3_effect_service import CreateOnceProvider, Intent, Receipt\n8\tfrom cairn.runtime.effect_ledger import EffectLedger\n9\t\n10\tWORKSPACE = Path(__file__).resolve().parent\n11\tREMOTE = Path('D:\\\\project-unknown-phase4\\\\results\\\\phase-4\\\\reconstitution-v5\\\\sealed-workloads\\\\effect-r\\\\remote')\n12\tINTENT_PATH = WORKSPACE / \".cairn-effect-intent.json\"\n13\tRESPONSE_PATH = WORKSPACE / \".cairn-provider-response.json\"\n14\tOBSERVATION_PATH = WORKSPACE / \".cairn-effect-observation.json\"\n15\tRECEIPT_PATH = WORKSPACE / \".cairn-effect-receipt.json\"\n16\tRESOLUTION_PATH = WORKSPACE / \".cairn-effect-resolution.json\"\n17\tLEDGER = WORKSPACE / \".cairn-effects.jsonl\"\n18\t\n19\tdef write(path, value):\n20\t    path.write_text(json.dumps(value, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n21\t\n22\tdef intent():\n23\t    return Intent(\"p4-claude-create-once\", \"p4-claude-key\", \"p4-claude-request\", \"create-once\")\n24\t\n25\tdef load_intent():\n26\t    return Intent(**json.loads(INTENT_PATH.read_text(encoding=\"utf-8\")))\n27\t\n28\tdef main(command):\n29\t    provider = CreateOnceProvider(REMOTE)\n30\t    if command == \"init\":\n31\t        value = intent()\n32\t        write(INTENT_PATH, asdict(value))\n33\t        EffectLedger(str(LEDGER), \"p4-claude\").append_effect(\"create-once\", value.idempotency_key, value.tool_class)\n34\t        print(\"intent-durable\")\n35\t    elif command == \"create\":\n36\t        value = load_intent()\n37\t        provider.dispatch(value)\n38\t        write(RESPONSE_PATH, asdict(provider.commit(value)))\n39\t        print(\"provider-committed-without-durable-receipt\")\n40\t    elif command == \"observe\":\n41\t        value = load_intent()\n42\t        observation = provider.observe(value)\n43\t        write(OBSERVATION_PATH, asdict(observation))\n44\t        print(observation.state)\n45\t    elif command in {\"receipt\", \"close-skip\"}:\n46\t        value = load_intent()\n47\t        observation = provider.observe(value)\n48\t        if observation.state != \"present\" or observation.request_fingerprint != value.request_fingerprint:\n49\t            raise SystemExit(\"cannot close without matching observed resource\")\n50\t        receipt = Receipt(value.effect_id, value.idempotency_key, value.request_fingerprint, observation.resource_id, \"commit\" if command == \"receipt\" else \"reobserve\")\n51\t        write(RECEIPT_PATH, asdict(receipt))\n52\t        EffectLedger(str(LEDGER), \"p4-claude\").complete_effect(value.idempotency_key)\n53\t        write(RESOLUTION_PATH, {\"decision\": \"complete\" if command == \"receipt\" else \"skip\", \"observation\": asdict(observation)})\n54\t        print(\"closed\")\n55\t    else:\n56\t        raise SystemExit(\"usage: effect_tool.py init|create|observe|receipt|close-skip\")\n57\t\n58\tif __name__ == \"__main__\":\n59\t    main(sys.argv[1] if len(sys.argv) == 2 else \"\")\n60\t",
